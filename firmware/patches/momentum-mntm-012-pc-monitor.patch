 }
 
 void furi_hal_bt_update_advertising_flags(uint8_t flags) {
-    GapState state = gap_get_state();
-
     /*
-     * Always update the cached manufacturer payload.
-     *
-     * When connected there is no advertising, so the
-     * new value will naturally be used after disconnect.
+     * Always refresh the cached manufacturer payload first. When
+     * connected there is no advertising, so the new value is used
+     * automatically after the next disconnect.
      */
     gap_update_advertising_flags(flags);
 
     /*
-     * If currently advertising, refresh it through the
-     * normal GAP lifecycle.
-     *
-     * Do NOT call the raw HCI scan-response API here.
+     * If the BLE stack is down there is nothing live to refresh;
+     * the cache update above is enough. Avoids issuing HCI
+     * stop/start against an inactive controller.
+     */
+    if(!furi_hal_bt_is_active()) {
+        return;
+    }
+
+    /*
+     * Skip the heavy advertising restart when the flags value did
+     * not change. The FAP re-asserts the same flag on every launch;
+     * a needless stop/start briefly drops the advertisement and can
+     * disturb an in-progress connection.
      */
-    if(state == GapStateAdvFast ||
-       state == GapStateAdvLowPower) {
+    static uint8_t last_flags = 0xFF;
+    if(flags == last_flags) {
+        return;
+    }
+    last_flags = flags;
 
+    /*
+     * Refresh advertising through the normal GAP lifecycle only
+     * while actually advertising. Do NOT call the raw HCI
+     * scan-response API here.
+     */
+    GapState state = gap_get_state();
+    if(state == GapStateAdvFast || state == GapStateAdvLowPower) {
         furi_hal_bt_stop_advertising();
         furi_hal_bt_start_advertising();
     }
